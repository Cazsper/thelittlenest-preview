{
  "_meta": {
    "purpose": "The single registry of every CMS-managed content key. Consumed by three things: cms/stamp-content.py (adds data-cms attributes to the HTML and extracts today's values as defaults), the Worker (decides what to inject), and build/admin/admin.js (renders the editors and groups them).",
    "rule": "A key is a STABLE IDENTIFIER, never a CSS selector. Renaming a class must not detach the CMS, and a CMS edit must never be able to alter the design.",
    "kinds": {
      "text": "plain string, HTML-escaped on injection",
      "richtext": "limited inline HTML: br, em, strong, a. Sanitised on save AND on injection.",
      "link": "{ label, href }",
      "image": "{ media_id | src, alt }",
      "list": "array of objects, ordered, each with a visible flag",
      "flag": "boolean, drives section visibility",
      "number": "integer, drives section order"
    },
    "anchor": "Each entry names the file and a unique anchor string used to locate the element for stamping. The stamper fails loudly if an anchor is not found exactly once."
  },
  "groups": [
    {
      "id": "global",
      "title": "Site-wide",
      "blurb": "Appears on all 186 pages. A change here is the widest-reaching edit in the system.",
      "icon": "globe",
      "sections": [
        {
          "id": "global.announce",
          "title": "Announcement bar",
          "blurb": "The strip above the header. The safest and most useful thing to change.",
          "fields": [
            {
              "key": "global.announce.text",
              "label": "Message",
              "kind": "richtext",
              "help": "Three short facts separated by a middle dot reads best. Keep it factual.",
              "file": "*",
              "anchor": "<div class=\"announce\">\n  <p>",
              "close": "</p>"
            },
            {
              "key": "global.announce.visible",
              "label": "Show the announcement bar",
              "kind": "flag",
              "default": true,
              "file": "*",
              "target": "div.announce"
            }
          ]
        },
        {
          "id": "global.footer",
          "title": "Footer",
          "fields": [
            {
              "key": "global.footer.blurb",
              "label": "Footer paragraph",
              "kind": "richtext",
              "file": "*",
              "anchor": "<p class=\"footer__blurb\">",
              "close": "</p>"
            },
            {
              "key": "global.footer.email",
              "label": "Contact email",
              "kind": "text",
              "file": "*",
              "anchor": "<a class=\"footer__email\"",
              "attr": "text"
            },
            {
              "key": "global.footer.hours",
              "label": "Opening hours",
              "kind": "text",
              "file": "*",
              "anchor": "<p class=\"footer__hours\">",
              "close": "</p>"
            },
            {
              "key": "global.footer.tagline",
              "label": "Base tagline",
              "kind": "text",
              "file": "*",
              "anchor": "<span>Take Your Comfort Home</span>",
              "close": "</span>"
            }
          ]
        }
      ]
    },
