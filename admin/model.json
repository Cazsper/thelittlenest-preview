  "not_editable": [
    {
      "what": "Policies page (shipping, returns, privacy, terms)",
      "why": "The freight bands on this page are legally load-bearing. A previous mismatch between this page and what Zoho charged at checkout is recorded in the project as a Fair Trading Act exposure. This text must only ever change alongside the Zoho freight configuration, never independently through a content form."
    },
    {
      "what": "Navigation structure and page slugs",
      "why": "186 pages carry relative links and a sitemap built from them. A rename is a redirect decision, not a text edit. build-shop-pages.py already has a REDIRECTS mechanism for that."
    },
    {
      "what": "Product titles, SKUs, prices and variants",
      "why": "Owned by the price list and Zoho. A third editable copy would make the reconciliation problem recorded in PRODUCT-DATA-AUDIT-2026-08-13.md strictly worse."
    },
    {
      "what": "Meta titles and descriptions on product pages",
      "why": "Derived from product data. Should stay derived so they cannot drift from the product."
    },
    {
      "what": "Contact form endpoint and checkout flow",
      "why": "Functionality, not content."
    }
  ]
